NODE_ENV=development
DEBUG=true
LOG_LEVEL=debug

API_PORT=3000
API_NAME=api
API_TRUSTED_PROXY_COUNT=0

MONGODB_HOST=mongodb
MONGODB_PORT=27017
MONGODB_USER=root
MONGODB_PASSWORD=example
MONGODB_DATABASE=admin
TEST_MONGODB_URI=mongodb://root:example@mongodb:27017/?authSource=admin

ACCOUNT_ACCESS_TOKEN_LIFETIME_SECONDS=900
ACCOUNT_JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
ACCOUNT_LOGIN_CODE_LIFETIME_SECONDS=300
ACCOUNT_LOGIN_CODE_MAXIMUM_ATTEMPTS=5
ACCOUNT_LOGIN_CODE_RESEND_INTERVAL_SECONDS=60
ACCOUNT_PASSWORD_MINIMUM_DIGITS=0
ACCOUNT_PASSWORD_MINIMUM_LOWERCASE=0
ACCOUNT_PASSWORD_MINIMUM_SYMBOLS=0
ACCOUNT_PASSWORD_MINIMUM_UPPERCASE=0
ACCOUNT_PHONE_VERIFICATION_CODE_LENGTH=6
ACCOUNT_REFRESH_TOKEN_LIFETIME_SECONDS=2592000
ACCOUNT_THROTTLE_MAXIMUM_REQUESTS=20
ACCOUNT_THROTTLE_WINDOW_SECONDS=300
