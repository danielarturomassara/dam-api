NODE_ENV=development
DEBUG=true
LOG_LEVEL=debug

API_PORT=3000
API_NAME=api

MONGODB_HOST=mongodb
MONGODB_PORT=27017
MONGODB_USER=root
MONGODB_PASSWORD=example
MONGODB_DATABASE=admin
TEST_MONGODB_URI=mongodb://root:example@mongodb:27017/?authSource=admin

ACCOUNT_PASSWORD_MINIMUM_DIGITS=0
ACCOUNT_PASSWORD_MINIMUM_LOWERCASE=0
ACCOUNT_PASSWORD_MINIMUM_SYMBOLS=0
ACCOUNT_PASSWORD_MINIMUM_UPPERCASE=0
ACCOUNT_PHONE_VERIFICATION_CODE_LENGTH=6
