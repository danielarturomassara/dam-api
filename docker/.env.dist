# Rendered by gauntlet/init.sh; committed defaults for docker/compose.yml.
# docker/.env is the local copy compose reads — override there, never here.
COMPOSE_PROJECT_NAME=dam
COMPOSE_IGNORE_ORPHANS=true

# Alpine tag of the node image; derived from engines.node in package.json.
NODE_VERSION=26-alpine

# This repository's service: /workspace/<SERVICE_NAME> in the container.
SERVICE_NAME=api
SERVICE_PORT=3000
SERVICE_PUBLIC_PORT=3000
SERVICE_PUBLIC_DEBUG_PORT=9229

# mongodb — shared by the sibling repositories of dam
MONGODB_VERSION=8.2.2
MONGODB_USER=root
MONGODB_PASSWORD=example
MONGODB_PUBLIC_PORT=27017
