{
  "hooks": {
    "PostToolUse": [
      {
        "hooks": [
          {
            "command": "node \"$CLAUDE_PROJECT_DIR/gauntlet/hook/claude/lintChangedFile.mjs\"",
            "timeout": 120,
            "type": "command"
          }
        ],
        "matcher": "Edit|Write"
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "command": "node \"$CLAUDE_PROJECT_DIR/gauntlet/hook/claude/protectPaths.mjs\"",
            "timeout": 30,
            "type": "command"
          }
        ],
        "matcher": "Edit|Write"
      },
      {
        "hooks": [
          {
            "command": "node \"$CLAUDE_PROJECT_DIR/gauntlet/hook/claude/checkBashCommand.mjs\"",
            "timeout": 30,
            "type": "command"
          }
        ],
        "matcher": "Bash"
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "node \"$CLAUDE_PROJECT_DIR/gauntlet/hook/claude/snapshotSession.mjs\"",
            "timeout": 60,
            "type": "command"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "command": "node \"$CLAUDE_PROJECT_DIR/gauntlet/hook/claude/runGauntletOnStop.mjs\"",
            "timeout": 600,
            "type": "command"
          }
        ]
      }
    ]
  }
}
