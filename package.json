{
  "author": "Daniel Arturo Massara",
  "dependencies": {
    "axios": "1.21.1",
    "bcrypt": "6.0.0",
    "body-parser": "2.4.0",
    "commander": "15.1.0",
    "compression": "1.8.2",
    "cors": "2.8.6",
    "dotenv": "18.0.10",
    "express": "5.3.0",
    "glob": "14.0.6",
    "helmet": "8.3.0",
    "html-to-text": "10.0.1",
    "inversify": "8.3.0",
    "jsonwebtoken": "9.0.3",
    "mongodb": "7.9.1",
    "ms": "2.1.3",
    "nodemailer": "10.6.1",
    "pg": "8.23.1",
    "reflect-metadata": "0.2.2",
    "uuid": "14.0.3",
    "winston": "3.19.0",
    "winston-daily-rotate-file": "5.0.0",
    "zod": "4.6.7"
  },
  "description": "Daniel Arturo Massara API",
  "devDependencies": {
    "@cspell/dict-es-es": "3.0.9",
    "@stryker-mutator/core": "10.1.1",
    "@stryker-mutator/vitest-runner": "10.1.1",
    "@stylistic/eslint-plugin": "6.0.1",
    "@types/bcrypt": "6.0.0",
    "@types/compression": "1.8.1",
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/html-to-text": "9.0.4",
    "@types/jsonwebtoken": "9.0.10",
    "@types/ms": "2.1.0",
    "@types/nodemailer": "8.0.2",
    "@types/pg": "8.23.1",
    "@typescript-eslint/eslint-plugin": "8.73.0",
    "@typescript-eslint/parser": "8.73.0",
    "@vitest/coverage-v8": "5.1.1",
    "cspell": "10.5.2",
    "dependency-cruiser": "18.8.0",
    "eslint": "10.15.0",
    "eslint-plugin-jsonc": "3.4.2",
    "eslint-plugin-perfectionist": "5.14.0",
    "eslint-plugin-sonarjs": "4.2.2",
    "eslint-plugin-unused-imports": "4.4.1",
    "fast-check": "4.10.3",
    "mongodb-memory-server": "11.3.0",
    "ts-node": "10.9.2",
    "tsconfig-replace-paths": "1.0.0",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vite-tsconfig-paths": "6.1.1",
    "vitest": "5.1.1"
  },
  "engines": {
    "node": ">=26 <27"
  },
  "license": "ISC",
  "main": "dist/index.js",
  "name": "@danielarturomassara/api",
  "scripts": {
    "baseline:crap": "node gauntlet/crap.mjs --write-baseline",
    "baseline:depcruise": "mkdir -p baseline && depcruise src --output-type baseline --output-to baseline/depcruise.json",
    "build": "tsc -p tsconfig.build.json && tsconfig-replace-paths -p tsconfig.build.json",
    "crap": "node gauntlet/crap.mjs",
    "cspell": "cspell lint \"**\" --dot",
    "depcruise": "node gauntlet/gauntlet.mjs --only depcruise",
    "dev": "tsx watch src/index.ts",
    "gauntlet": "node gauntlet/gauntlet.mjs",
    "gauntlet:full": "node gauntlet/gauntlet.mjs --full",
    "lint": "eslint 'src/**/*.ts' 'test/**/*.ts' --no-error-on-unmatched-pattern",
    "lint-fix": "eslint 'src/**/*.ts' 'test/**/*.ts' --no-error-on-unmatched-pattern --fix",
    "prebuild": "rm -rf dist && npm run lint-fix",
    "seeder": "tsx ./src/cli.ts",
    "start": "node ./dist/index.js",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:mutation": "stryker run",
    "type-check": "tsc --noEmit"
  },
  "type": "module",
  "version": "1.0.0"
}
