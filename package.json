{
  "author": "Daniel Arturo Massara",
  "dependencies": {
    "axios": "1.12.2",
    "bcrypt": "6.0.0",
    "body-parser": "2.2.0",
    "commander": "14.0.1",
    "compression": "1.8.1",
    "cors": "2.8.5",
    "dotenv": "17.2.3",
    "express": "5.1.0",
    "glob": "11.0.3",
    "helmet": "8.1.0",
    "html-to-text": "9.0.5",
    "inversify": "7.10.2",
    "jsonwebtoken": "9.0.2",
    "mongodb": "6.20.0",
    "ms": "2.1.3",
    "nodemailer": "7.0.9",
    "pg": "8.16.3",
    "reflect-metadata": "0.2.2",
    "uuid": "13.0.0",
    "winston": "3.18.3",
    "winston-daily-rotate-file": "5.0.0",
    "zod": "4.5.4"
  },
  "description": "Daniel Arturo Massara API",
  "devDependencies": {
    "@cspell/dict-es-es": "3.0.8",
    "@stryker-mutator/core": "10.0.0",
    "@stryker-mutator/vitest-runner": "10.0.0",
    "@stylistic/eslint-plugin": "5.4.0",
    "@types/bcrypt": "6.0.0",
    "@types/compression": "1.8.1",
    "@types/cors": "2.8.19",
    "@types/express": "5.0.3",
    "@types/html-to-text": "9.0.4",
    "@types/jsonwebtoken": "9.0.10",
    "@types/ms": "2.1.0",
    "@types/nodemailer": "7.0.2",
    "@types/pg": "8.15.5",
    "@typescript-eslint/eslint-plugin": "8.46.1",
    "@typescript-eslint/parser": "8.46.1",
    "@vitest/coverage-v8": "4.1.11",
    "cspell": "9.2.1",
    "dependency-cruiser": "17.4.3",
    "eslint": "9.37.0",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-jsonc": "2.21.0",
    "eslint-plugin-perfectionist": "4.15.1",
    "eslint-plugin-sonarjs": "4.2.0",
    "eslint-plugin-unused-imports": "4.2.0",
    "fast-check": "4.9.0",
    "mongodb-memory-server": "11.2.0",
    "ts-node": "10.9.2",
    "tsconfig-replace-paths": "1.0.0",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vite-tsconfig-paths": "6.1.1",
    "vitest": "4.1.11"
  },
  "engines": {
    "node": ">=26 <27"
  },
  "license": "ISC",
  "main": "dist/index.js",
  "name": "@danielarturomassara/api",
  "scripts": {
    "baseline:crap": "node gauntlet/crap.mjs --write-baseline",
    "baseline:depcruise": "mkdir -p baseline && depcruise src --output-type baseline --output-to baseline/depcruise.json",
    "build": "tsc -p tsconfig.build.json && tsconfig-replace-paths -p tsconfig.build.json",
    "crap": "node gauntlet/crap.mjs",
    "cspell": "cspell lint \"**\" --dot",
    "depcruise": "node gauntlet/gauntlet.mjs --only depcruise",
    "dev": "tsx watch src/index.ts",
    "gauntlet": "node gauntlet/gauntlet.mjs",
    "gauntlet:full": "node gauntlet/gauntlet.mjs --full",
    "lint": "eslint 'src/**/*.ts' 'test/**/*.ts' --no-error-on-unmatched-pattern",
    "lint-fix": "eslint 'src/**/*.ts' 'test/**/*.ts' --no-error-on-unmatched-pattern --fix",
    "prebuild": "rm -rf dist && npm run lint-fix",
    "seeder": "tsx ./src/cli.ts",
    "start": "node ./dist/index.js",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:mutation": "stryker run",
    "type-check": "tsc --noEmit"
  },
  "type": "module",
  "version": "1.0.0"
}
