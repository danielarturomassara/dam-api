{
  "compilerOptions": {
    "emitDecoratorMetadata": true,
    "esModuleInterop": true,
    "experimentalDecorators": true,
    "forceConsistentCasingInFileNames": true,
    "isolatedModules": false,
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "paths": {
      "@account/*": [
        "./src/account/1.0/*"
      ],
      "@core/*": [
        "./src/core/1.0/*"
      ],
      "@src/*": [
        "./src/*"
      ]
    },
    "removeComments": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "sourceMap": false,
    "strict": true,
    "strictNullChecks": true,
    "target": "ESNext"
  },
  "exclude": [
    "gauntlet/template",
    "node_modules"
  ],
  "ts-node": {
    "esm": true
  }
}
